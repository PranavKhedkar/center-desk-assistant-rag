# Copy to .env and fill in. .env is gitignored — never commit real tokens.

# Hugging Face Inference API token (free tier). Get one at:
# https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxx

# Optional overrides (defaults live in app/config.py):
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# TOP_K=3
# SCORE_THRESHOLD=0.6
# CORS_ORIGINS=["http://localhost:3000"]
